$assert REQUANTIZATION in ["FP32"]
$assert DATATYPE in ["QC8", "QS8"] 
$assert MR == 16
$assert NR in ["m4", "m8"]
$OUT_LMUL = NR
$IN_LMUL = {"m4": "m1", "m8": "m2"}[OUT_LMUL]
$INTER_LMUL = {"m4": "m2", "m8": "m4"}[OUT_LMUL]
#include <assert.h>

#include <riscv_vector.h>

#include "xnnpack/bme.h"
#include "xnnpack/gemm.h"
#include "xnnpack/math.h"

$DATATYPE_SPEC = {"QS8": "qs8", "QC8": "qs8_qc8w"}[DATATYPE]
$PARAMS_TYPE = {"QC8": "union xnn_qs8_qc8w_conv_minmax_params", "QS8": "union xnn_qs8_conv_minmax_params"}[DATATYPE]
$if DATATYPE in ["QC8", "QS8"]:
  $REQUANTIZATION_SPEC = "_" + REQUANTIZATION.lower() if REQUANTIZATION else ""
  $PARAMS_STRUCT = REQUANTIZATION.lower() + "_scalar"
$else:
  $REQUANTIZATION_SPEC = ""
  $PARAMS_STRUCT = ""
$XINT8_T = "int8_t"
$OUT_T = {"QC8": "int8_t", "QS8": "int8_t"}[DATATYPE]
void xnn_${DATATYPE_SPEC}_gemm_minmax${REQUANTIZATION_SPEC}_ukernel_${MR}x${OUT_LMUL[1]}v__rvv(
    size_t mr,
    size_t nc,
    size_t kc,
    const ${XINT8_T}* restrict a,
    size_t a_stride,
    const void* restrict w,
    ${OUT_T}* restrict c,
    size_t cm_stride,
    size_t cn_stride,
    const ${PARAMS_TYPE} params[restrict XNN_MIN_ELEMENTS(1)])
{
  assert(mr != 0);
  assert(nc != 0);
  assert(kc != 0);
  
  ${XINT8_T}* a0 = a;
  ${OUT_T}* c0 = c;
  
  size_t nr;
  __asm__ volatile("vsetvli %0, zero, e32, ${OUT_LMUL}, ta, ma" : "=r"(nr));
  size_t vl = nr;

  $if DATATYPE != "QC8":
    const float vscale = params->${PARAMS_STRUCT}.scale;
  const int32_t output_min_less_zero_point = (int32_t) params->${PARAMS_STRUCT}.output_min - (int32_t) params->${PARAMS_STRUCT}.output_zero_point;
  const int32_t output_max_less_zero_point = (int32_t) params->${PARAMS_STRUCT}.output_max - (int32_t) params->${PARAMS_STRUCT}.output_zero_point;
  const int32_t output_zero_point = params->${PARAMS_STRUCT}.output_zero_point;
  do {
    if XNN_UNLIKELY(nc < nr) {
      __asm__ volatile("vsetvli %0, %1, e32, ${OUT_LMUL}, ta, ma" : "=r"(vl) : "r"(nc));

    }
    nc = nc - vl;

    __asm__ volatile("vle32.v v0, (%0)" : : "r"((const int32_t*)w));
    OPMVINBCAST(m1, v0); // broadcast channel-wise bias
    w = (const int32_t*) w + nr;

    size_t k = 0;
    do {

      __asm__ volatile("vsetvli zero, %0, e8, ${IN_LMUL}, ta, ma" : : "r"(mr));
      __asm__ volatile("vlse8.v v8, (%0), %1" : : "r"((uintptr_t) a0), "r"(a_stride));
      __asm__ volatile("vsetvli zero, %0, e8, ${IN_LMUL}, ta, ma" : : "r"(vl));
      __asm__ volatile("vle8.v v9, (%0)" : : "r"(w));
      VOPACC(m1, v8, v9);
      a0++;
      w = (const ${XINT8_T}*) w + nr;
      k += sizeof(${XINT8_T});
    } while (k != kc);
 
    $if DATATYPE == "QC8": 
      //v4 <- vscale
      __asm__ volatile("vsetvli zero, %0, e32, ${OUT_LMUL}, ta, ma" : : "r"(vl));
      __asm__ volatile("vle32.v v4, (%0)" : : "r"((const float*) w));
      w = (const float*) w + nr;

    ${OUT_T}* cm = c0;
    for (size_t r=0; r<mr; r++) {
      //v0 <- vopacc
      VMV_VR(v0, r, m1); // move row r of m1 into v0
      __asm__ volatile("vfcvt.f.x.v	v0,v0");
      $if DATATYPE == "QC8": 
        //v0 <- vopacc * vscale
        __asm__ volatile("vfmul.vv	v0,v0,v4");
      $else:
        __asm__ volatile("vfmul.vf	v0,v0,%0", : : "r"(vscale));
      
      //v0 <- minmax
      __asm__ volatile("vfmax.vf	v0,v0,%0" : : "f"((float) output_min_less_zero_point));
      __asm__ volatile("vfmin.vf	v0,v0,%0" : : "f"((float) output_max_less_zero_point));
      
      __asm__ volatile("vsetvli zero, %0, e16, ${INTER_LMUL}, ta, ma" : : "r"(vl));
      __asm__ volatile("vfncvt.x.f.w	v0,v0");
      __asm__ volatile("vadd.vx	v0,v0,%0" : : "r"((int16_t) output_zero_point));
      
      __asm__ volatile("vsetvli zero, %0, e8, ${IN_LMUL}, ta, ma" : : "r"(vl));
      __asm__ volatile("vncvt.x.x.w	v0,v0");
      
      __asm__ volatile("vse8.v	v0, (%0)" : : "r"(cm));
      cm = (${OUT_T}*) ((uintptr_t) cm + cm_stride);
    }
    c0 = (${OUT_T}*) ((uintptr_t) c0 + cn_stride);
    a0 = (${XINT8_T}*)  ((uintptr_t) a0 - kc);
  } while (nc != 0);
}